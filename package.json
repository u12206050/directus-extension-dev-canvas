{
	"name": "directus-extension-dev-canvas",
	"description": "A module for developing Directus extensions with hot-reloading",
	"icon": "extension",
	"version": "1.0.6",
	"license": "GNU-AGPL-3.0",
	"repository": "https://github.com/u12206050/directus-extension-dev-canvas.git",
	"author": "Gerard Lamusse",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-module"
	],
	"type": "module",
	"files": [
		"dist",
		"host-deps.js"
	],
	"directus:extension": {
		"type": "module",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": ">=11.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@directus/composables": "11.6.2",
		"@directus/extensions": "4.0.4",
		"@directus/extensions-sdk": "18.0.4",
		"@directus/types": "16.2.0",
		"@directus/utils": "13.5.4",
		"@vue/test-utils": "^2.5.1",
		"jsdom": "^25.0.1",
		"typescript": "^5.7.3",
		"vitest": "^2.1.9",
		"vue": "^3.5.24"
	}
}
